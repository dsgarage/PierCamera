.footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background-color: rgba(0, 0, 0, 0.4);
}

.preview-area {
    justify-content: center;
    align-items: center;
}

.preview-button {
    width: 60px;
    height: 60px;
    border-radius: 8px;
    border-width: 2px;
    border-color: white;
    background-size: cover;
    background-position: center;
    background-color: black;
}

.shutter-button {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    border-width: 4px;
    border-color: white;
    background-color: transparent;
}

.zoom-selector {
    flex-direction: row;
    gap: 10px;
}

.aspect-selector {
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
}

.zoom-button, .aspect-button {
    color: white;
    background-color: transparent;
    border-width: 0;
}

.zoom-button.selected, .aspect-button.selected {
    color: #FFD700;
}