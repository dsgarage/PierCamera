        {type:SET_PROPERTY,data:_ZWrite2=1}, {type:SET_PROPERTY,data:_ZTest2=4},  
        {type:SET_PROPERTY,data:_AlphaPremultiply2=0}]},\r\n\t\t{value:2,actions:[{type:SET_PROPERTY,data:_AlphaForceOpaque2=0},
        {type:SET_PROPERTY,data:_BlendOp2=0}, {type:SET_PROPERTY,data:_BlendOpAlpha2=4},
