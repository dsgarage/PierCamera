      description: 
    - name: _ModeTwoPass
      type: Float
      displayName: "Rendering Preset--{on_value_actions:[\r\n\t\t{value:0,actions:[{type:SET_PROPERTY,data:_AlphaForceOpaque2=1},
        {type:SET_PROPERTY,data:_BlendOp2=0}, {type:SET_PROPERTY,data:_BlendOpAlpha2=4},
        {type:SET_PROPERTY,data:_TwoPassAlphaCutoff=0},  \t\t{type:SET_PROPERTY,data:_SrcBlend2=1},
        {type:SET_PROPERTY,data:_DstBlend2=0},  {type:SET_PROPERTY,data:_SrcBlendAlpha2=1},
        {type:SET_PROPERTY,data:_DstBlendAlpha2=1},  {type:SET_PROPERTY,data:_AddSrcBlend2=1},
        {type:SET_PROPERTY,data:_AddDstBlend2=1}, {type:SET_PROPERTY,data:_AddSrcBlendAlpha2=0},
        {type:SET_PROPERTY,data:_AddDstBlendAlpha2=1}, {type:SET_PROPERTY,data:_AlphaToCoverage2=0}, 
        {type:SET_PROPERTY,data:_ZWrite2=1}, {type:SET_PROPERTY,data:_ZTest2=4},  
        {type:SET_PROPERTY,data:_AlphaPremultiply2=0}]},\r\n\t\t{value:1,actions:[{type:SET_PROPERTY,data:_AlphaForceOpaque2=0},
        {type:SET_PROPERTY,data:_BlendOp2=0}, {type:SET_PROPERTY,data:_BlendOpAlpha2=4},
        {type:SET_PROPERTY,data:_TwoPassAlphaCutoff=.5}, \t\t{type:SET_PROPERTY,data:_SrcBlend2=1},
        {type:SET_PROPERTY,data:_DstBlend2=0},  {type:SET_PROPERTY,data:_SrcBlendAlpha2=1},
