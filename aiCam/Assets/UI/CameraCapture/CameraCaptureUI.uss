/* ================================
   基本ルート設定
================================ */
.root {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    justify-content: flex-end;
    align-items: center;
    flex-direction: column;
    display: flex;
    position: absolute;
    top: 0;
    left: 0;
    padding-bottom: 0;
}

/* ================================
   アスペクト比マスクオーバーレイ
================================ */
.aspect-mask-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    /* display設定はC#側で制御 */
    pointer-events: none;
}

.aspect-mask {
    /* 全てC#側で制御するため、USSでは最低限のみ設定 */
    pointer-events: none;
}

/* ================================
   撮影ボタン
================================ */
.capture-button {
    width: 120px;
    height: 120px;
    justify-content: center;
    align-items: center;
    background-color: transparent;
    border-width: 0;
    display: flex;
    margin-bottom: 80px;
    margin-top: 24px;
}

/* 内側の円（白→赤に変化） */
.inner-circle {
    width: 90px;
    height: 90px;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    background-image: resource('UI/Buttons/CaptureButtonInner');
    -unity-background-scale-mode: scale-to-fit;
    transition-property: background-color;
    transition-duration: 0.3s;
    display: flex;
    pointer-events: none;
}

/* 録画中に赤く点灯 */
.inner-circle.recording {
    -unity-background-image-tint-color: rgba(255, 0, 0, 1);
}

/* 外枠リング画像 */
.outer-ring {
    position: absolute;
    width: 120px;
    height: 120px;
    background-image: resource('UI/Buttons/CaptureButtonOuter');
    -unity-background-scale-mode: scale-to-fit;
    display: flex;
    pointer-events: none;
}

/* プログレスリング（4つのセグメントを使用） */
.progress-ring {
    position: absolute;
    width: 120px;
    height: 120px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
    display: flex;
    pointer-events: none;
    justify-content: center;
    align-items: center;
}

/* 録画中のみ表示 */
.progress-ring.active {
    opacity: 1;
}

/* プログレスバーの背景リング（薄い赤） */
.progress-ring-bg {
    position: absolute;
    width: 120px;
    height: 120px;
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    border-color: rgba(255, 0, 0, 0.2);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    pointer-events: none;
}

/* プログレス表示用の円弧（時計回り） */
.progress-arc {
    position: absolute;
    width: 120px;
    height: 120px;
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    border-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    pointer-events: none;
    rotate: -90deg;
}

/* ================================
   サムネイル領域 - Issue #431: 削除
================================ */
/* Issue #431: プレビュー機能削除のためコメントアウト
.gallery-thumbnail {
    position: absolute;
    bottom: 90px;
    left: 24px;
    width: 80px;
    height: 80px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: rgba(255, 255, 255, 0.8);
    background-color: rgba(34, 34, 34, 1);
    -unity-background-scale-mode: scale-and-crop;
    display: flex;
}
*/

/* ================================
   フラッシュオーバーレイ
================================ */
.flash-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: white;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
    display: flex;
    pointer-events: none;
}

/* ================================
   ビューア（全画面プレビュー） - Issue #431: 削除
================================ */
/* Issue #431: プレビュー機能削除のためコメントアウト
.viewer-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.95);
    justify-content: center;
    align-items: center;
    display: none;
    flex-direction: column;
}

.viewer-image {
    max-width: 90%;
    max-height: 90%;
    -unity-background-scale-mode: scale-to-fit;
    display: flex;
    pointer-events: none;
}
*/

/* 動画ビューア */
.viewer-video {
    max-width: 90%;
    max-height: 90%;
}

/* ================================
   上部パネル
================================ */
.top-panel {
    position: absolute;
    top: 100px;
    left: 16px;
    right: 16px;
    height: 64px;
    background-color: rgba(128, 128, 128, 0.5);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-left: 8px;
    padding-right: 8px;
}

/* 上部パネルのボタン - タッチ領域（Appleガイドライン準拠） */
.top-panel-button {
    width: 64px;
    height: 64px;
    min-width: 64px;
    min-height: 64px;
    background-color: transparent;
    border-width: 0;
    flex-grow: 0;
    flex-shrink: 0;
    -unity-font-style: bold;
    font-size: 14px;
    color: rgba(60, 60, 60, 1);
    -unity-background-scale-mode: scale-to-fit;
    padding: 14px;
    margin: 0;
}

.top-panel-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

/* 個別のアイコン設定 */
#topButton1 {
    background-image: resource('Sprite/PictIcon/TopPanel/01_Icon_Light');
}

#topButton2 {
    background-image: resource('Sprite/PictIcon/TopPanel/02_Icon_Shadow');
}

#topButton3 {
    background-image: resource('Sprite/PictIcon/TopPanel/03_Icon_Face');
}

#topButton4 {
    background-image: resource('Sprite/PictIcon/TopPanel/04_Icon_Pose');
}

/* Issue #345: 平面表示ボタン */
#topButton5 {
    background-image: resource('Sprite/PlaneVisibility');
}

/* Issue #345: 平面表示時 */
#topButton5.plane-visible {
    opacity: 1;
}

/* Issue #345: 平面非表示時（やや暗く表示） */
#topButton5.plane-hidden {
    opacity: 0.4;
}

/* ================================
   サイドバーパネル（左側中央）
================================ */
.side-panel {
    position: absolute;
    top: 50%;
    left: 16px;
    translate: 0 -50%;
    width: 72px;
    background-color: rgba(128, 128, 128, 0.5);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    padding-top: 12px;
    padding-bottom: 12px;
}

/* サイドバーのボタン */
.side-panel-button {
    width: 58px;
    height: 58px;
    background-color: transparent;
    border-width: 0;
    flex-grow: 0;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    padding: 0;
    margin-top: 6px;
    margin-bottom: 6px;
}

.side-panel-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

/* サイドバーボタンのアイコン設定 */
#sideButton1 {
    background-image: resource('Sprite/PictIcon/SideBear/01_Prefarence');
}

#sideButton2 {
    background-image: resource('Sprite/PictIcon/SideBear/02_01_Full');
}

#sideButton3 {
    background-image: resource('Sprite/PictIcon/SideBear/03_Flash');
}

/* Issue #413: バグレポートボタン */
#sideButtonBugReport {
    background-image: resource('Sprite/PictIcon/SideBear/04_BugReport');
}

.bug-report-button {
    background-color: transparent;
}

/* ================================
   撮影ボタン上のパネル（アバタースロット）
================================ */
.bottom-panel {
    position: absolute;
    bottom: 280px;
    left: 16px;
    right: 16px;
    height: 64px;
    background-color: rgba(128, 128, 128, 0.5);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    overflow: hidden;
}

/* 下部パネルのスクロールビュー */
.bottom-scroll-view {
    width: 100%;
    height: 100%;
}

.bottom-scroll-view > .unity-scroll-view__content-viewport {
    width: 100%;
    height: 100%;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
}

.bottom-scroll-view > .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-start;
    height: 100%;
    padding-left: 8px;
    padding-right: 8px;
}

/* スクロールバーを非表示（実機用） */
.bottom-scroll-view > #unity-horizontal-scroller {
    display: none;
}

.bottom-scroll-view > #unity-vertical-scroller {
    display: none;
}

/* 下部パネルのボタンコンテナ */
.bottom-button-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 100%;
    flex-shrink: 0;
}

/* 下部パネルのボタン（アバタースロット） */
.bottom-panel-button {
    width: 52px;
    height: 52px;
    background-color: rgba(255, 255, 255, 0.9);
    background-image: resource('Sprite/PictIcon/AvatarSlot/EmptySlotIcon');
    -unity-background-scale-mode: scale-to-fit;
    border-width: 0;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    flex-grow: 0;
    flex-shrink: 0;
    -unity-font-style: bold;
    font-size: 12px;
    color: rgba(60, 60, 60, 1);
    margin-left: 8px;
    margin-right: 8px;
}

.bottom-panel-button:hover {
    background-color: rgba(255, 255, 255, 1);
}

/* 選択中のスロット */
.bottom-panel-button.selected {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(80, 180, 255, 1);
}

/* アイコン設定済みスロット */
.bottom-panel-button.has-icon {
    background-color: transparent;
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0.4;
}

/* 選択中のアイコン付きスロット（通常の明るさ） */
.bottom-panel-button.has-icon.selected {
    opacity: 1;
}

/* +ボタン専用スタイル（アイコンなし、+テキストのみ） */
.bottom-panel-button-add {
    font-size: 14px;
    background-color: rgba(200, 200, 200, 0.8);
    background-image: none;
}

.bottom-panel-button-add:hover {
    background-color: rgba(220, 220, 220, 1);
}

/* bottomButton1: デフォルトアイコンは.bottom-panel-buttonに移動済み */

/* ================================
   削除メニューポップアップ
================================ */
.delete-popup {
    position: absolute;
    width: 120px;
    height: 80px;
    background-color: rgba(40, 40, 40, 0.95);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
    padding-top: 5px;
    padding-bottom: 5px;
    display: none;
}

.delete-popup-button {
    width: 100px;
    height: 32px;
    background-color: rgba(60, 60, 60, 1);
    border-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    flex-grow: 0;
    flex-shrink: 0;
    -unity-font-style: bold;
    font-size: 14px;
    color: white;
}

.delete-popup-button.delete {
    color: rgba(255, 60, 60, 1);
}

.delete-popup-button:hover {
    background-color: rgba(80, 80, 80, 1);
}

/* ================================
   アラートバー（警告/エラー表示）
================================ */
.alert-bar {
    position: absolute;
    top: 76px;
    left: 12px;
    right: 12px;
    min-height: 48px;
    background-color: rgba(255, 200, 0, 0.95);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 16px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    opacity: 0;
    display: none;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.alert-bar.visible {
    display: flex;
    opacity: 1;
}

.alert-bar.warning {
    background-color: rgba(255, 200, 0, 0.95);
}

.alert-bar.error {
    background-color: rgba(220, 60, 60, 0.95);
}

.alert-bar.info {
    background-color: rgba(80, 180, 220, 0.95);
}

.alert-bar-message {
    flex-grow: 1;
    flex-shrink: 1;
    -unity-font-style: bold;
    font-size: 16px;
    color: rgba(40, 40, 40, 1);
    white-space: normal;
    -unity-text-align: middle-left;
}

.alert-bar.error .alert-bar-message {
    color: white;
}

.alert-bar-close {
    width: 36px;
    height: 36px;
    background-color: rgba(0, 0, 0, 0.2);
    border-width: 0;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    flex-grow: 0;
    flex-shrink: 0;
    -unity-font-style: bold;
    font-size: 18px;
    color: rgba(40, 40, 40, 1);
    margin-left: 10px;
    -unity-text-align: middle-center;
}

.alert-bar.error .alert-bar-close {
    color: white;
}

.alert-bar-close:hover {
    background-color: rgba(0, 0, 0, 0.3);
}

/* ================================
   アイコンプレビューパネル
================================ */
.icon-preview-panel {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    justify-content: center;
    align-items: center;
    flex-direction: column;
    opacity: 0;
    display: none;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.icon-preview-panel.visible {
    display: flex;
    opacity: 1;
}

.icon-preview-image {
    width: 80%;
    height: 60%;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 40px;
}

.icon-preview-button-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.icon-preview-button {
    width: 150px;
    height: 52px;
    background-color: rgba(255, 255, 255, 0.9);
    border-width: 0;
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    border-bottom-left-radius: 26px;
    border-bottom-right-radius: 26px;
    -unity-font-style: bold;
    font-size: 18px;
    color: rgba(40, 40, 40, 1);
    margin-left: 16px;
    margin-right: 16px;
    -unity-text-align: middle-center;
}

.icon-preview-button:hover {
    background-color: rgba(255, 255, 255, 1);
}

.icon-preview-button.confirm {
    background-color: rgba(80, 180, 80, 0.95);
    color: white;
}

.icon-preview-button.confirm:hover {
    background-color: rgba(100, 200, 100, 1);
}

.icon-preview-button.retake {
    background-color: rgba(100, 100, 100, 0.9);
    color: white;
}

.icon-preview-button.retake:hover {
    background-color: rgba(120, 120, 120, 1);
}
/* ================================
   バージョン表示ラベル
================================ */
.version-label {
    position: absolute;
    bottom: 8px;
    right: 8px;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
    -unity-text-align: lower-right;
    -unity-font-style: normal;
    padding: 2px 4px;
}

/* ================================
   エクスポートポップアップ (Issue #458)
================================ */
.export-popup-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    justify-content: center;
    align-items: center;
    flex-direction: column;
    opacity: 0;
    display: none;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.export-popup-overlay.visible {
    display: flex;
    opacity: 1;
}

.export-popup-panel {
    width: 320px;
    min-height: 200px;
    background-color: rgba(50, 50, 50, 0.98);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 20px;
    padding-right: 20px;
}

.export-popup-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.export-popup-message {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.8);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 24px;
    padding-left: 8px;
    padding-right: 8px;
}

.export-loading-indicator {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    display: none;
}

.export-loading-indicator.visible {
    display: flex;
}

.export-loading-spinner {
    width: 40px;
    height: 40px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    border-left-color: rgba(80, 180, 255, 1);
    border-right-color: rgba(80, 180, 255, 0.3);
    border-top-color: rgba(80, 180, 255, 0.3);
    border-bottom-color: rgba(80, 180, 255, 0.3);
    margin-bottom: 12px;
}

.export-loading-text {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-center;
}

.export-button-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: auto;
}

.export-popup-button {
    width: 130px;
    height: 48px;
    background-color: rgba(80, 80, 80, 0.9);
    border-width: 0;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
    -unity-font-style: bold;
    font-size: 16px;
    color: white;
    margin-left: 8px;
    margin-right: 8px;
    -unity-text-align: middle-center;
}

.export-popup-button:hover {
    background-color: rgba(100, 100, 100, 1);
}

.export-popup-button:disabled {
    opacity: 0.5;
}

.export-popup-button.cancel {
    background-color: rgba(100, 100, 100, 0.9);
}

.export-popup-button.cancel:hover {
    background-color: rgba(120, 120, 120, 1);
}

.export-popup-button.confirm {
    background-color: rgba(80, 150, 220, 0.95);
}

.export-popup-button.confirm:hover {
    background-color: rgba(100, 170, 240, 1);
}

/* 破壊的アクション用ボタン（赤） */
.export-popup-button.destructive {
    background-color: rgba(220, 80, 80, 0.95);
}

.export-popup-button.destructive:hover {
    background-color: rgba(240, 100, 100, 1);
}
