/* ================================
   Issue #120/#74: ライティングパネルスタイル
   コンパクト版 - スクロール不要
================================ */

/* フルスクリーンバックドロップ（パネル外クリックで閉じる用） */
.lighting-panel-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.3);
    display: none;
}

.lighting-panel-backdrop.visible {
    display: flex;
}

/* オーバーレイ（パネルコンテナ） - 画面全体に配置、Safe Area対応 */
.lighting-panel-overlay {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 60px;       /* 上部ボタン領域を避ける */
    bottom: 80px;    /* 下部ボタン領域 + Safe Area */
    background-color: transparent;
    display: none;
    flex-direction: column;
    justify-content: center;  /* パネルを中央揃え */
    align-items: stretch;
}

.lighting-panel-overlay.visible {
    display: flex;
}

/* メインパネル：コンテナ内に収まるよう自動調整、スクロール対応 */
.lighting-panel {
    width: 100%;
    max-height: 100%;  /* オーバーレイ内に収まる範囲で最大化 */
    background-color: rgba(20, 20, 20, 0.95);
    border-radius: 8px;
    padding: 6px 8px;  /* パディング縮小 */
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    flex-direction: column;
    overflow: scroll;
    flex-shrink: 1;    /* 必要に応じて縮小 */
    flex-grow: 0;      /* 必要以上に拡大しない */
}

/* ヘッダー */
.lighting-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.15);
    flex-shrink: 0;
    height: 18px;
}

.lighting-panel-title {
    font-size: 10px;
    color: white;
    -unity-font-style: bold;
}

.lighting-panel-close {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: rgba(255, 255, 255, 0.15);
    border-width: 0;
    color: white;
    font-size: 10px;
    -unity-text-align: middle-center;
}

.lighting-panel-close:hover {
    background-color: rgba(255, 255, 255, 0.3);
}

.lighting-panel-close:active {
    background-color: rgba(76, 175, 255, 0.5);
}

/* セクション - コンパクト */
.lighting-section {
    margin-bottom: 3px;
    flex-shrink: 0;
}

.section-label {
    font-size: 8px;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 2px;
    -unity-font-style: bold;
}

.section-label-small {
    font-size: 8px;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 2px;
}

/* プリセットボタン - コンパクト */
.preset-container {
    flex-direction: row;
    flex-wrap: wrap;
    margin: -1px;
    flex-shrink: 0;
}

.preset-button {
    flex-grow: 0;
    width: 44px;
    height: 18px;
    margin: 1px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.8);
    font-size: 7px;
    -unity-text-align: middle-center;
}

.preset-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

.preset-button:active {
    background-color: rgba(76, 175, 255, 0.4);
    border-color: rgba(76, 175, 255, 0.8);
}

.preset-button.preset-selected {
    background-color: rgba(76, 175, 255, 0.4);
    border-color: rgba(76, 175, 255, 1);
    color: white;
    -unity-font-style: bold;
}

/* スライダー共通 - コンパクト */
.slider-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0px;
    height: 12px;
    flex-shrink: 0;
}

.slider-value {
    font-size: 8px;
    color: rgba(76, 175, 255, 1);
    -unity-font-style: bold;
}

.lighting-slider {
    margin-top: 0px;
    margin-bottom: 1px;
    height: 14px;
    flex-shrink: 0;
}

.lighting-slider > .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: white;
    border-width: 2px;
    border-color: rgba(76, 175, 255, 1);
    margin-top: -5px;
}

.lighting-slider > .unity-base-slider__tracker {
    height: 4px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.2);
}

.lighting-slider > .unity-base-slider__drag-container > .unity-base-slider__dragger-border {
    display: none;
}

/* 色温度グラデーション - コンパクト */
.color-temp-gradient {
    height: 4px;
    border-radius: 2px;
    margin-bottom: 1px;
    background: linear-gradient(to right, #ff9500, #ffcc00, #ffffff, #aaccff, #6699ff);
    flex-shrink: 0;
}

/* ライト方向コントロール - コンパクト版 */
.light-direction-control {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    height: 55px;
}

.light-direction-background {
    width: 50px;
    height: 50px;
    border-radius: 25px;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    position: relative;
}

/* Issue #74: EWSN方向ラベル
   親: 50x50px, border: 1px → 内部(contentRect): 48x48px
   ラベル: 8x8px
   水平中央: (48-8)/2 = 20px
*/
.direction-label {
    position: absolute;
    font-size: 6px;
    color: rgba(255, 255, 255, 0.5);
    -unity-text-align: middle-center;
    width: 8px;
    height: 8px;
}

.direction-n {
    top: 1px;
    left: 20px;
}

.direction-s {
    bottom: 1px;
    left: 20px;
}

.direction-e {
    right: 1px;
    top: 20px;
}

.direction-w {
    left: 1px;
    top: 20px;
}

/* Issue #74: ノブの初期位置
   contentRect基準で計算:
   - background: 50x50px, border: 1px → contentRect: 48x48px
   - contentRect中心: 24px
   - ノブ: 12x12px
   - 北方向（上）初期位置: left=24-6=18px, top=4px
*/
.light-direction-knob {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: rgba(255, 200, 50, 1);
    border-width: 2px;
    border-color: white;
    left: 18px;
    top: 4px;
}

.light-direction-knob:hover {
    scale: 1.1;
}

/* Elevation コントロール - コンパクト */
.elevation-control {
    flex-direction: column;
    align-items: center;
    width: 35px;
}

.elevation-label {
    font-size: 6px;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 0px;
}

.elevation-slider {
    height: 40px;
    width: 18px;
}

.elevation-slider > .unity-base-slider__dragger {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: white;
    border-width: 2px;
    border-color: rgba(76, 175, 255, 1);
    margin-left: -3px;
}

.elevation-slider > .unity-base-slider__tracker {
    width: 4px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.2);
}

.elevation-value {
    font-size: 7px;
    color: rgba(76, 175, 255, 1);
    margin-top: 0px;
}

/* トグル行 - コンパクト */
.toggle-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
    height: 20px;
    flex-shrink: 0;
}

/* トグル行 - コンパクト版（上下パディング付き） */
.toggle-row-compact {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
    padding-top: 4px;
    padding-bottom: 4px;
    min-height: 20px;
    flex-shrink: 0;
}

.toggle-label {
    font-size: 8px;
    color: rgba(255, 255, 255, 0.8);
    flex-grow: 1;
    flex-shrink: 1;
}

/* Toggle の枠(40px)は compact 行に合わせる */
.toggle-row > Toggle,
.toggle-row-compact > Toggle {
    width: 40px;
    min-width: 40px;
    max-width: 40px;
    flex-grow: 0;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

/* Toggle 本体：スイッチの全体サイズ */
.shadow-toggle,
.ar-sync-toggle {
    width: 20px;
    height: 10px;
    min-width: 20px;
    min-height: 10px;
    max-width: 20px;
    max-height: 10px;
    padding: 0;
    margin: 0;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: center;
    overflow: hidden;
}

/* ラベルは消す */
.shadow-toggle Label,
.ar-sync-toggle Label {
    display: none;
}

/* input は子孫指定で確実に当てる */
.shadow-toggle .unity-toggle__input,
.ar-sync-toggle .unity-toggle__input {
    width: 20px;
    height: 10px;
    min-width: 20px;
    min-height: 10px;
    max-width: 20px;
    max-height: 10px;
    padding: 0;
    margin: 0;
    flex-grow: 0;
    flex-shrink: 0;
    overflow: hidden;
}

/* checkmark = トラック（背景の帯） */
.shadow-toggle .unity-toggle__checkmark,
.ar-sync-toggle .unity-toggle__checkmark {
    width: 20px;
    height: 10px;
    min-width: 20px;
    min-height: 10px;
    max-width: 20px;
    max-height: 10px;
    padding: 0;
    margin: 0;
    border-radius: 5px;
    /* デフォ画像は消す（帯だけにする） */
    background-image: none;
    border-width: 0;
    background-color: rgba(255, 255, 255, 0.2);
    position: relative;
    overflow: hidden;
}

/* checkmark-image = ノブとして再利用 */
.shadow-toggle .unity-toggle__checkmark-image,
.ar-sync-toggle .unity-toggle__checkmark-image {
    display: flex;
    position: absolute;
    left: 1px;
    top: 1px;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: white;
}

/* ON のとき帯の色 */
.shadow-toggle.unity-toggle--checked .unity-toggle__checkmark,
.ar-sync-toggle.unity-toggle--checked .unity-toggle__checkmark,
.shadow-toggle:checked .unity-toggle__checkmark,
.ar-sync-toggle:checked .unity-toggle__checkmark {
    background-color: rgba(76, 175, 255, 1);
}

/* ON のときノブを右へ */
.shadow-toggle.unity-toggle--checked .unity-toggle__checkmark-image,
.ar-sync-toggle.unity-toggle--checked .unity-toggle__checkmark-image,
.shadow-toggle:checked .unity-toggle__checkmark-image,
.ar-sync-toggle:checked .unity-toggle__checkmark-image {
    left: 11px;
}

/* ソフトネスボタン - コンパクト */
.softness-container {
    margin-top: 2px;
    flex-shrink: 0;
}

.softness-buttons {
    flex-direction: row;
    margin-top: 0px;
    height: 18px;
    flex-shrink: 0;
}

.softness-button {
    flex-grow: 1;
    height: 16px;
    margin-right: 2px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.7);
    font-size: 7px;
}

.softness-button:last-child {
    margin-right: 0;
}

.softness-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

.softness-button:active {
    background-color: rgba(76, 175, 255, 0.4);
    border-color: rgba(76, 175, 255, 0.8);
}

.softness-button.softness-selected {
    background-color: rgba(76, 175, 255, 0.4);
    border-color: rgba(76, 175, 255, 1);
    color: white;
    -unity-font-style: bold;
}

/* AR同期セクション - コンパクト（下部用・未使用） */
.ar-sync-section {
    padding-top: 2px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
}

/* AR同期セクション - ヘッダー直下用 */
.ar-sync-section-top {
    margin-top: 0px;
    margin-bottom: 4px;
    padding-bottom: 0;
    flex-shrink: 0;
}

.ar-sync-description {
    font-size: 6px;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 0px;
}
