/* ================================
   Issue #120/#74/#432: ライティングパネルスタイル
   Issue #432: サイズを拡大して操作しやすく調整
================================ */

/* フルスクリーンバックドロップ（パネル外クリックで閉じる用） */
.lighting-panel-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.3);
    display: none;
}

.lighting-panel-backdrop.visible {
    display: flex;
}

/* オーバーレイ（パネルコンテナ） - 画面下50%に配置 */
.lighting-panel-overlay {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 50%;        /* 画面上端から50%の位置から開始 */
    bottom: 8px;     /* 画面下端から8pxまで */
    background-color: transparent;
    display: none;
    flex-direction: column;
    justify-content: flex-end;  /* パネルを下揃え */
    align-items: stretch;
}

.lighting-panel-overlay.visible {
    display: flex;
}

/* メインパネル：コンテナ内に収まるよう自動調整、スクロール対応 */
/* Issue #432: パディングを増やしてサイズを拡大 */
.lighting-panel {
    width: 100%;
    max-height: 100%;  /* オーバーレイ内に収まる範囲で最大化 */
    background-color: rgba(20, 20, 20, 0.95);
    border-radius: 16px;
    padding: 16px;
    padding-bottom: 28px; /* Issue #432: 下部に余白を追加 */
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    flex-direction: column;
    overflow: scroll;
    flex-shrink: 1;    /* 必要に応じて縮小 */
}

/* ヘッダー - Issue #432: サイズ拡大 */
.lighting-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.15);
    flex-shrink: 0;
    height: 36px;
}

.lighting-panel-title {
    font-size: 18px;
    color: white;
    -unity-font-style: bold;
}

.lighting-panel-close {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.15);
    border-width: 0;
    color: white;
    font-size: 18px;
    -unity-text-align: middle-center;
}

.lighting-panel-close:hover {
    background-color: rgba(255, 255, 255, 0.3);
}

.lighting-panel-close:active {
    background-color: rgba(76, 175, 255, 0.5);
}

/* セクション - Issue #432: サイズ拡大 */
.lighting-section {
    margin-bottom: 12px;
    flex-shrink: 0;
}

.section-label {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.section-label-small {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 4px;
}

/* プリセットボタン - Issue #432: サイズ拡大 */
.preset-container {
    flex-direction: row;
    flex-wrap: wrap;
    margin: -2px;
    flex-shrink: 0;
}

.preset-button {
    flex-grow: 0;
    width: 80px;
    height: 36px;
    margin: 3px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.8);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.preset-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

.preset-button:active {
    background-color: rgba(76, 175, 255, 0.4);
    border-color: rgba(76, 175, 255, 0.8);
}

.preset-button.preset-selected {
    background-color: rgba(76, 175, 255, 0.4);
    border-color: rgba(76, 175, 255, 1);
    color: white;
    -unity-font-style: bold;
}

/* スライダー共通 - Issue #432: サイズ拡大 */
.slider-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
    height: 24px;
    flex-shrink: 0;
}

.slider-value {
    font-size: 14px;
    color: rgba(76, 175, 255, 1);
    -unity-font-style: bold;
}

.lighting-slider {
    margin-top: 4px;
    margin-bottom: 6px;
    height: 28px;
    flex-shrink: 0;
}

.lighting-slider > .unity-base-slider__dragger {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background-color: white;
    border-width: 3px;
    border-color: rgba(76, 175, 255, 1);
    margin-top: -8px;
}

.lighting-slider > .unity-base-slider__tracker {
    height: 8px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.2);
}

.lighting-slider > .unity-base-slider__drag-container > .unity-base-slider__dragger-border {
    display: none;
}

/* 色温度グラデーション - Issue #432: サイズ拡大 */
.color-temp-gradient {
    height: 8px;
    border-radius: 4px;
    margin-bottom: 4px;
    background: linear-gradient(to right, #ff9500, #ffcc00, #ffffff, #aaccff, #6699ff);
    flex-shrink: 0;
}

/* ライト方向コントロール - Issue #432: サイズ拡大 */
.light-direction-control {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    height: 120px;
}

.light-direction-background {
    width: 110px;
    height: 110px;
    border-radius: 55px;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    position: relative;
}

/* Issue #74/#432: EWSN方向ラベル - サイズ拡大
   親: 110x110px, border: 1px → 内部(contentRect): 108x108px
   ラベル: 14x14px (フォントサイズ12pxに合わせる)
   水平中央: (108-14)/2 = 47px
   垂直中央: (108-14)/2 = 47px
*/
.direction-label {
    position: absolute;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    -unity-text-align: middle-center;
    width: 14px;
    height: 14px;
}

.direction-n {
    top: 2px;
    left: 47px;
}

.direction-s {
    bottom: 2px;
    left: 47px;
}

.direction-e {
    right: 2px;
    top: 47px;
}

.direction-w {
    left: 2px;
    top: 47px;
}

/* Issue #74/#432: ノブの初期位置 - サイズ拡大
   contentRect基準で計算:
   - background: 110x110px, border: 1px → contentRect: 108x108px
   - contentRect中心: 54px
   - ノブ半径: 12px
   - 有効半径: min(54, 54) - 18 = 36px
   - 北方向（上）初期位置: left=54-12=42px, top=54-36-12=6px
*/
.light-direction-knob {
    position: absolute;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background-color: rgba(255, 200, 50, 1);
    border-width: 3px;
    border-color: white;
    left: 42px;
    top: 6px;
}

.light-direction-knob:hover {
    scale: 1.1;
}

/* Elevation コントロール - Issue #432: サイズ拡大 */
.elevation-control {
    flex-direction: column;
    align-items: center;
    width: 60px;
}

.elevation-label {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 4px;
}

.elevation-slider {
    height: 80px;
    width: 32px;
}

.elevation-slider > .unity-base-slider__dragger {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: white;
    border-width: 3px;
    border-color: rgba(76, 175, 255, 1);
    margin-left: -5px;
}

.elevation-slider > .unity-base-slider__tracker {
    width: 8px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.2);
}

.elevation-value {
    font-size: 14px;
    color: rgba(76, 175, 255, 1);
    margin-top: 4px;
}

/* トグル行 - Issue #432: サイズ拡大 */
.toggle-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    height: 56px;
    flex-shrink: 0;
}

/* トグル行 - Issue #432: サイズ拡大 */
.toggle-row-compact {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    padding-top: 12px;
    padding-bottom: 12px;
    min-height: 44px;
    flex-shrink: 0;
}

.toggle-label {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.8);
    flex-grow: 1;
    flex-shrink: 1;
}

/* Toggle の枠 - Issue #432: サイズ拡大 */
.toggle-row > Toggle,
.toggle-row-compact > Toggle {
    width: 60px;
    min-width: 60px;
    max-width: 60px;
    flex-grow: 0;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

/* Toggle 本体 - Issue #432: サイズ拡大 */
.shadow-toggle,
.ar-sync-toggle {
    width: 40px;
    height: 22px;
    min-width: 40px;
    min-height: 22px;
    max-width: 40px;
    max-height: 22px;
    padding: 0;
    margin: 0;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: center;
    overflow: hidden;
}

/* ラベルは消す */
.shadow-toggle Label,
.ar-sync-toggle Label {
    display: none;
}

/* input - Issue #432: サイズ拡大 */
.shadow-toggle .unity-toggle__input,
.ar-sync-toggle .unity-toggle__input {
    width: 40px;
    height: 22px;
    min-width: 40px;
    min-height: 22px;
    max-width: 40px;
    max-height: 22px;
    padding: 0;
    margin: 0;
    flex-grow: 0;
    flex-shrink: 0;
    overflow: hidden;
}

/* checkmark = トラック（背景の帯） - Issue #432: サイズ拡大 */
.shadow-toggle .unity-toggle__checkmark,
.ar-sync-toggle .unity-toggle__checkmark {
    width: 40px;
    height: 22px;
    min-width: 40px;
    min-height: 22px;
    max-width: 40px;
    max-height: 22px;
    padding: 0;
    margin: 0;
    border-radius: 11px;
    /* デフォ画像は消す（帯だけにする） */
    background-image: none;
    border-width: 0;
    background-color: rgba(255, 255, 255, 0.2);
    position: relative;
    overflow: hidden;
}

/* checkmark-image = ノブ - Issue #432: サイズ拡大 */
.shadow-toggle .unity-toggle__checkmark-image,
.ar-sync-toggle .unity-toggle__checkmark-image {
    display: flex;
    position: absolute;
    left: 2px;
    top: 2px;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: white;
}

/* ON のとき帯の色 */
.shadow-toggle.unity-toggle--checked .unity-toggle__checkmark,
.ar-sync-toggle.unity-toggle--checked .unity-toggle__checkmark,
.shadow-toggle:checked .unity-toggle__checkmark,
.ar-sync-toggle:checked .unity-toggle__checkmark {
    background-color: rgba(76, 175, 255, 1);
}

/* ON のときノブを右へ - Issue #432: サイズ拡大 */
.shadow-toggle.unity-toggle--checked .unity-toggle__checkmark-image,
.ar-sync-toggle.unity-toggle--checked .unity-toggle__checkmark-image,
.shadow-toggle:checked .unity-toggle__checkmark-image,
.ar-sync-toggle:checked .unity-toggle__checkmark-image {
    left: 20px;
}

/* ソフトネスボタン - Issue #432: サイズ拡大 */
.softness-container {
    margin-top: 6px;
    flex-shrink: 0;
}

.softness-buttons {
    flex-direction: row;
    margin-top: 4px;
    height: 36px;
    flex-shrink: 0;
}

.softness-button {
    flex-grow: 1;
    height: 32px;
    margin-right: 6px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.8);
    font-size: 13px;
}

.softness-button:last-child {
    margin-right: 0;
}

.softness-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

.softness-button:active {
    background-color: rgba(76, 175, 255, 0.4);
    border-color: rgba(76, 175, 255, 0.8);
}

.softness-button.softness-selected {
    background-color: rgba(76, 175, 255, 0.4);
    border-color: rgba(76, 175, 255, 1);
    color: white;
    -unity-font-style: bold;
}

/* AR同期セクション - コンパクト（下部用・未使用） */
.ar-sync-section {
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
}

/* AR同期セクション - ヘッダー直下用 */
.ar-sync-section-top {
    margin-top: 2px;
    margin-bottom: 8px;
    padding-bottom: 0;
    flex-shrink: 0;
}

.ar-sync-description {
    font-size: 7px;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 1px;
}

/* ================================
   シャドウパネルスタイル - Issue #432: サイズ拡大
================================ */

/* オーバーレイ（パネルコンテナ） */
.shadow-panel-overlay {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 100px;
    background-color: transparent;
    display: none;
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
}

.shadow-panel-overlay.visible {
    display: flex;
}

/* メインパネル - Issue #432: サイズ拡大 */
.shadow-panel {
    width: 100%;
    background-color: rgba(20, 20, 20, 0.95);
    border-radius: 16px;
    padding: 16px;
    padding-bottom: 24px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    flex-direction: column;
}

/* ヘッダー - Issue #432: サイズ拡大 */
.shadow-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.15);
    height: 36px;
}

.shadow-panel-title {
    font-size: 18px;
    color: white;
    -unity-font-style: bold;
}

.shadow-panel-close {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.15);
    border-width: 0;
    color: white;
    font-size: 18px;
    -unity-text-align: middle-center;
}

.shadow-panel-close:hover {
    background-color: rgba(255, 255, 255, 0.3);
}

.shadow-panel-close:active {
    background-color: rgba(76, 175, 255, 0.5);
}

/* セクション - Issue #432: サイズ拡大 */
.shadow-section {
    margin-bottom: 12px;
}

/* シャドウスライダー - Issue #432: サイズ拡大 */
.shadow-slider {
    margin-top: 4px;
    margin-bottom: 6px;
    height: 28px;
}

.shadow-slider > .unity-base-slider__dragger {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background-color: white;
    border-width: 3px;
    border-color: rgba(76, 175, 255, 1);
    margin-top: -8px;
}

.shadow-slider > .unity-base-slider__tracker {
    height: 8px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.2);
}
