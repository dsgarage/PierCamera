<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="RuntimeFBXLoaderWithFileBrowser.uss" />
    <ui:VisualElement name="AppRoot" class="app-root" style="background-color: rgba(0, 0, 0, 0); height: 100%; position: relative;">
    
        <!-- 上：ログパネル -->
        <ui:VisualElement name="LogPanel" class="log-panel">
            <ui:Label text="ロードログ" class="log-title"/>
            <ui:ScrollView name="LogScroll" class="log-scroll">
                <ui:TextField name="LogField" multiline="true" readonly="true" class="log-field" style="background-color: rgba(0, 0, 0, 0); border-width: 0; color: rgb(204, 204, 204);"/>
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- 中央：進行パネル -->
        <ui:VisualElement name="ProgressPanel" class="progress-panel">
            <ui:Label name="LoadingLabel" text="待機中..." class="loading-label"/>
            <ui:ProgressBar name="ProgressBar" value="0" high-value="100" class="progress-bar"/>
        </ui:VisualElement>

        <!-- 下：操作パネル -->
        <ui:VisualElement name="ControlPanel" class="control-panel" style="position: absolute; bottom: 0; left: 0; right: 0; flex-direction: row; background-color: rgb(41, 43, 48); padding: 14px 12px; margin: 0 12px 12px 12px; border-radius: 12px;">
            <ui:Button name="BtnOpen" text="ファイルを選択" class="btn primary" style="flex-grow: 1; height: 44px; background-color: rgb(42, 130, 218); color: white; border-radius: 8px; margin: 0 6px; border-width: 0;"/>
            <ui:Button name="BtnLoad" text="ロード開始" class="btn success" style="flex-grow: 1; height: 44px; background-color: rgb(58, 165, 93); color: white; border-radius: 8px; margin: 0 6px; border-width: 0;"/>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>