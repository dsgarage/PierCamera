<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="RuntimeFBXLoaderWithFileBrowser.uss" />
    <ui:VisualElement name="AppRoot" class="app-root" style="background-color: rgba(0, 0, 0, 0); height: 100%; position: relative;">
    
        <!-- 上：ログパネル -->
        <ui:VisualElement name="LogPanel" class="log-panel">
            <ui:ScrollView name="LogScroll" class="log-scroll" style="background-color: rgba(0, 0, 0, 0);">
                <ui:TextField name="LogField" multiline="true" readonly="true" class="log-field" style="background-color: rgba(0, 0, 0, 0); border-width: 0; color: rgb(180, 180, 180);"/>
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- 中央：進行パネル -->
        <ui:VisualElement name="ProgressPanel" class="progress-panel">
            <ui:Label name="LoadingLabel" text="待機中..." class="loading-label"/>
            <ui:ProgressBar name="ProgressBar" value="0" high-value="100" class="progress-bar"/>
        </ui:VisualElement>

        <!-- 下：操作パネル -->
        <ui:VisualElement name="ControlPanel" class="control-panel" style="position: absolute; bottom: 0; left: 0; right: 0; flex-direction: row; background-color: rgb(41, 43, 48); padding: 14px 12px; margin: 0 12px 12px 12px; border-radius: 12px;">
            <ui:Button name="BtnLoad" text="ロード開始" class="btn success" style="flex-grow: 2; height: 44px; background-color: rgb(58, 165, 93); color: white; border-radius: 8px; margin: 0 6px 0 0; border-width: 0;"/>
            <ui:Button name="BtnOpen" text="選択" class="btn primary" style="flex-grow: 1; height: 44px; background-color: rgb(42, 130, 218); color: white; border-radius: 8px; margin: 0 3px; border-width: 0; font-size: 13px;"/>
            <ui:Button name="BtnExtract" text="解凍" class="btn secondary" style="flex-grow: 1; height: 44px; background-color: rgb(108, 117, 125); color: white; border-radius: 8px; margin: 0 0 0 3px; border-width: 0; font-size: 13px;"/>
        </ui:VisualElement>

        <!-- ポップアップオーバーレイ -->
        <ui:VisualElement name="PopupOverlay" class="popup-overlay" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.6); display: none; align-items: center; justify-content: center;">
            <ui:VisualElement name="PopupPanel" class="popup-panel" style="background-color: rgb(41, 43, 48); border-radius: 16px; padding: 24px; width: 300px; align-items: center;">
                <ui:Label name="PopupTitle" text="アバターを削除しますか？" style="font-size: 16px; -unity-font-style: bold; color: white; margin-bottom: 20px; -unity-text-align: middle-center;"/>
                <ui:VisualElement style="flex-direction: row; width: 100%;">
                    <ui:Button name="BtnDeleteAvatar" text="削除" class="btn danger" style="flex-grow: 1; height: 44px; background-color: rgb(220, 53, 69); color: white; border-radius: 8px; margin: 0 6px 0 0; border-width: 0; font-size: 14px; -unity-font-style: bold;"/>
                    <ui:Button name="BtnCancelPopup" text="キャンセル" class="btn secondary" style="flex-grow: 1; height: 44px; background-color: rgb(108, 117, 125); color: white; border-radius: 8px; margin: 0 0 0 6px; border-width: 0; font-size: 14px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>