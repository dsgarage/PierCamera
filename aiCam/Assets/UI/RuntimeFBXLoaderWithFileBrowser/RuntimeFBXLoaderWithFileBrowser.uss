/* Root */
.root {
    flex-direction: column;
    background-color: rgb(242, 242, 247);
    height: 100%;
    width: 100%;
}

/* Content Area - Scrollable */
.content-area {
    flex-grow: 1;
    padding: 16px;
    padding-bottom: 24px;
}

/* Card Style */
.card {
    background-color: rgb(255, 255, 255);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 16px;
}

/* Status Card */
.status-label {
    font-size: 18px;
    color: rgb(60, 60, 67);
    -unity-font-style: bold;
    margin-bottom: 16px;
}

.loading-container {
    flex-direction: column;
    display: none;
}

.progress-bar {
    height: 6px;
    border-radius: 3px;
    background-color: rgb(229, 229, 234);
    margin-bottom: 8px;
}

.progress-label {
    font-size: 14px;
    color: rgb(142, 142, 147);
    -unity-text-align: middle-center;
}

/* Log Card */
.card-title {
    font-size: 14px;
    color: rgb(142, 142, 147);
    -unity-font-style: bold;
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.log-area {
    min-height: 200px;
    background-color: rgb(249, 249, 249);
    border-radius: 12px;
    padding: 16px;
    font-size: 13px;
    color: rgb(60, 60, 67);
    border-width: 0;
}

/* Bottom Bar - Fixed */
.bottom-bar {
    flex-direction: row;
    background-color: rgb(255, 255, 255);
    padding: 12px 16px;
    padding-bottom: 24px;
    border-top-width: 0.5px;
    border-top-color: rgb(229, 229, 234);
}

/* Action Buttons */
.action-button {
    flex-grow: 1;
    height: 56px;
    margin: 0 6px;
    border-radius: 14px;
    font-size: 16px;
    -unity-font-style: bold;
    border-width: 0;
    transition-duration: 0.2s;
}

.primary-button {
    background-color: rgb(0, 122, 255);
    color: rgb(255, 255, 255);
}

.primary-button:hover {
    background-color: rgb(10, 132, 255);
}

.primary-button:active {
    background-color: rgb(0, 112, 245);
}

.primary-button:disabled {
    background-color: rgb(209, 209, 214);
    color: rgb(174, 174, 178);
}

.secondary-button {
    background-color: rgb(242, 242, 247);
    color: rgb(0, 122, 255);
    border-width: 2px;
    border-color: rgb(0, 122, 255);
}

.secondary-button:hover {
    background-color: rgb(229, 229, 234);
}

.secondary-button:active {
    background-color: rgb(219, 219, 224);
}

.secondary-button:disabled {
    background-color: rgb(249, 249, 249);
    color: rgb(174, 174, 178);
    border-color: rgb(209, 209, 214);
}
