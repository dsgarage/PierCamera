/* ベースレイアウト */
.app-root {
    position: relative;
    flex-direction: column;
    background-color: rgb(30, 31, 34);
    color: rgb(229, 229, 229);
    height: 100%;
    width: 100%;
    padding-top: 12px;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
}

/* ログパネル */
.log-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    background-color: rgb(37, 38, 42);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(46, 47, 51);
    padding: 12px;
    margin-left: 16px;
    margin-right: 16px;
    margin-bottom: 10px;
    padding-bottom: 100px;
    min-height: 200px;
}

.log-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 6px;
}

.log-scroll {
    flex-grow: 1;
    background-color: rgb(24, 25, 27);
    border-radius: 4px;
    padding: 8px;
}

.log-field {
    background-color: transparent;
    border-width: 0;
    color: rgb(204, 204, 204);
    font-size: 13px;
    min-height: 180px;
}

/* 進行パネル */
.progress-panel {
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 10px;
    margin-bottom: 10px;
    margin-left: 16px;
    margin-right: 16px;
    padding-bottom: 100px;
    background-color: rgb(32, 33, 36);
    border-width: 1px;
    border-color: rgb(46, 47, 51);
    border-radius: 6px;
    padding: 10px 14px;
}

.loading-label {
    font-size: 13px;
    color: rgb(170, 170, 170);
    margin-bottom: 4px;
}

.progress-bar {
    height: 10px;
}

/* 操作パネル（下部固定） */
.control-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    flex-direction: row;
    background-color: rgb(41, 43, 48);
    border-radius: 12px;
    padding: 14px 12px;
    margin-left: 12px;
    margin-right: 12px;
    margin-bottom: 12px;
    border-top-width: 1px;
    border-top-color: rgb(51, 51, 51);
}

/* ボタンデザイン */
.btn {
    flex-grow: 1;
    flex-basis: 0;
    height: 44px;
    border-radius: 8px;
    -unity-font-style: bold;
    font-size: 15px;
    border-width: 0;
    color: rgb(255, 255, 255);
    transition-duration: 0.12s;
    margin-left: 6px;
    margin-right: 6px;
}

.btn.primary {
    background-color: rgb(42, 130, 218);
}
.btn.primary:hover {
    background-color: rgb(61, 150, 235);
}
.btn.primary:active {
    background-color: rgb(31, 107, 184);
}
.btn.primary:disabled {
    background-color: rgb(68, 68, 68);
    color: rgb(102, 102, 102);
}

.btn.success {
    background-color: rgb(58, 165, 93);
}
.btn.success:hover {
    background-color: rgb(78, 194, 113);
}
.btn.success:active {
    background-color: rgb(45, 138, 71);
}
.btn.success:disabled {
    background-color: rgb(68, 68, 68);
    color: rgb(102, 102, 102);
}
