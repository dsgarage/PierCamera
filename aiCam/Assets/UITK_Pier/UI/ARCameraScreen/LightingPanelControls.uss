@import url("../Styles/tokens.uss");
/* ================================
   ロジック
================================ */
.tab-content{ display: none; }
.tab-content.is-active{ display: flex; }

/* ================================
   メインパネル
================================ */
/* フルスクリーンバックドロップ（パネル外クリックで閉じる用） : ユーザーの見た目の調整を損なわないように背景カラーは完全透明*/
.lighting-panel-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    display: none;
}

.lighting-panel-backdrop.visible {
    display: flex;
}

/* オーバーレイ（パネルコンテナ）：絶対的な大きさと、下からの絶対位置を規定 */
.lighting-panel-overlay {
    position: absolute;
    left: 0px;
    right: 0px;
    bottom: 0px;

    height: 334px;
    background-color: transparent;
    display: none;
    flex-direction: column;
    justify-content: flex-start;
}

.lighting-panel-overlay.visible {
    display: flex;
}

/* メインパネル：コンテナ内に収まりつつ、flex方向は絶対値で大きさを規定（後でスクロール対応する？） */
.lighting-panel {
    position: absolute;
    left: 0px;
    right: 0px;
    bottom: 4px;

    height: 330px;
    flex-direction: column;
    flex-shrink: 0;
    padding-top: 8px;

    border-radius: 16px;
    background-color: rgba(32,31,31,.95);
}

/* ヘッダー */
.lighting-panel-header {
    padding-left: 16px;
    padding-right: 8px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 44px;
    flex-shrink: 0;
}

.lighting-panel-title {
    font-size: 20px;
    font-weight: 600;
    margin-top: 0px;
    margin-bottom: 0px;
    padding-top: 0px;
    padding-bottom: 0px;
    line-height: 20px;
    color: rgba(255,255,255,1);
}

.lighting-panel-close {
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 0;
    color: white;
    font-size: 16px;
    -unity-text-align: middle-center;
}

.lighting-panel-close:hover {
    background-color: rgba(255, 255, 255, 0.3);
}

.lighting-panel-close:active {
    background-color: rgba(76, 175, 255, 0.5);
}

/* セクション(共通) */
.lighting-section {
    margin-bottom: 0px;
    flex-shrink: 0;
}

.section-label {
    font-size: 12px;
    font-weight: 600;
    margin-top: 0px;
    margin-bottom: 4px;
    padding-top: 0px;
    padding-bottom: 0px;
    line-height: 12px;
    color: rgba(255,255,255,1);
}

.section-label-small {
    font-size: 8px;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 2px;
}

/* トグル行(共通) */
.toggle-row {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: flex-start;
    align-items: center;
    padding-right: 16px;
    padding-left: 16px;
    height: 40px;
}

.toggle-label {
    font-size: 12px;
    font-weight: 600;
    color: rgba(255, 255, 255, 1);
    flex-shrink: 1;
    margin-right: 40px;
}

/* Toggle の枠*/
.toggle-row > Toggle {
    width: 64px;
    flex-grow: 0;
    flex-shrink: 0;
    justify-content: flex-start;
    align-items: center;
    overflow: hidden;
}

/* ディバイダー(共通) */
.divider{
  height: 1px;
  background-color: rgba(124,122,123,1);
}

/* AR同期セクション - ヘッダー直下用 */
/* Toggle 本体：スイッチの全体サイズ */
.shadow-toggle,
.ar-sync-toggle {
    width: 32px;
    height: 16px;
    border-radius: 8px;
    padding: 0;
    margin: 0;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: center;
    overflow: hidden;
}

#autoSyncDivider{
  margin-left: 16px;
  margin-right: 16px;
}

/* --- tab 選択行 --- */
.tab-bar{
  padding-top: 12px;
  padding-bottom: 8px;
  padding-left: 16px;
  padding-right: 16px;
  flex-direction: row;
  flex-shrink: 0;
  justify-content: left;
}
.tab-container{
  flex-direction: row;
  justify-content: left;
  align-items: center; 
  height: 25px; /* 後でhugに調整 */

  border-radius: 12.5px;
  background-color: rgba(51,50,50,1);
}
.tab{
  flex-direction: row;
  flex-shrink: 0;
  flex-grow: 0;
  justify-content: center;
  align-items: center; 
  height: 100%;

  padding-left: 12px;
  padding-right: 12px;
  padding-top: 4px;
  padding-bottom: 4px;

  border-radius: 16px;
}
.tab-label{
  font-size: 14px;
  margin-top: 0px;
  margin-bottom: 0px;
  padding-top: 0px;
  padding-bottom: 0px;
  line-height: 14px;
  color: rgba(255,255,255,1);
}
.tab.is-selected{
  background-color: rgba(1,168,212,1);
}

/* --- tab の中身のコンテナとタイトル --- */
.tab-content{
  flex-direction: column;
  padding-left: 16px;
  padding-right: 16px;
}
.section-title{
  font-size: 12px;
  font-weight: 600;
  margin-top: 0px;
  margin-bottom: 4px;
  padding-top: 0px;
  padding-bottom: 0px;
  line-height: 12px;
  color: rgba(255,255,255,1);
}

/* ================================
   Mood-tabの中身
================================ */
/* プリセットボタン - コンパクト */
.preset-selections{
  flex-direction: row;
  flex-shrink: 0;
  justify-content: left;
  align-items: center; 
  height: 31px;
  margin-bottom: 16px;
}

.preset-container {
    flex-direction: row;
    align-items: center;
    width: auto;
}

.preset-button {
    flex-direction: row;
    flex-shrink: 0;
    flex-grow: 0;
    justify-content: center;
    align-items: center; 
    height: 100%;

    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-right: 4px;

    border-radius: 16px;
    background-color: rgba(51,50,50,1);
    color: rgba(255, 255, 255, 0.8);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.preset-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

.preset-button:active {
    background-color: rgba(1,168,212,1);
    border-color: rgba(76, 175, 255, 0.8);
}

.preset-button.preset-selected {
    background-color: rgba(1,168,212,1);
    border-color: rgba(76, 175, 255, 1);
    color: white;
    -unity-font-style: bold;
}

/* スライダー共通 */
.slider-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1px;
    height: 14px;
    flex-shrink: 0;
}

.slider-value {
    font-size: 9px;
    color: rgb(184, 184, 184);
    -unity-font-style: bold;
}

.lighting-slider {
    margin-top: 4px;
    margin-bottom: 8px;
    height: 24px;
    flex-shrink: 0;
}

/* track（バー）周り：background/progress/track を全部丸める */
/* .lighting-slider .unity-base-slider__track,
.lighting-slider .unity-base-slider__tracker,
.lighting-slider .unity-base-slider__progress {
    height: 4px;
    border-radius: 2px;
} */

/* ノブ周り：dragger/handle/border を全部丸める */
.lighting-slider .unity-base-slider__dragger,
.lighting-slider .unity-base-slider__drag-container,
.lighting-slider .unity-base-slider__dragger-border {
    border-radius: 6px;
}

.lighting-slider > .unity-base-slider__dragger {
    width: 12px;
    height: 24px;
    border-radius: 6px;
    background-color: white;
    border-width: 2px;
    border-color: rgba(76, 175, 255, 1);
    margin-top: -5px;
}

.lighting-slider > .unity-base-slider__tracker {
    height: 4px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.2);
}

.lighting-slider > .unity-base-slider__drag-container > .unity-base-slider__dragger-border {
    display: none;
}



/* 色温度グラデーション - コンパクト */
/* .color-temp-gradient {
    height: 4px;
    border-radius: 2px;
    margin-bottom: 1px;
    background: linear-gradient(to right, #ff9500, #ffcc00, #ffffff, #aaccff, #6699ff);
    flex-shrink: 0;
} */

/* ================================
   Direction-tabの中身
================================ */
.direction-root{
  flex-direction: row;
  justify-content: left;
  padding-top: 12px;
  padding-bottom: 12px;
  height: 176px;
}

/* ライト方向コントロール - コンパクト版 */
/* .light-direction-control {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    height: 70px;
} */

.direction-control{
    flex-direction: column;
    justify-content: top;
    align-items: center;
    margin-right:24px;
}

.light-direction-background {
    width: 136px;
    height: 136px;
    border-radius: 9999px;
    background-color: rgba(180, 180, 180, 1);
    position: relative;
}

/* Issue #74: EWSN方向ラベル
   親: 65x65px, border: 1px → 内部(contentRect): 63x63px
   ラベル: 8x8px (フォントサイズ7pxに合わせる)
   水平中央: (63-8)/2 = 27.5 ≈ 27px
   垂直中央: (63-8)/2 = 27.5 ≈ 27px
*/
.direction-label {
    font-size: 12px;
    font-weight: 600;
    margin-top: 0px;
    margin-bottom: 0px;
    padding-top: 0px;
    padding-bottom: 0px;
    line-height: 12px;
    color: rgba(0,0,0,1);
}

.direction-n { position:absolute; left:50%; top:4px; translate:-50% 0; }
.direction-s { position:absolute; left:50%; bottom:4px; translate:-50% 0; }
.direction-e { position:absolute; left:4px; top:50%; translate:0 -50%; }
.direction-w { position:absolute; right:4px; top:50%; translate:0 -50%; }

/* Issue #74: ノブの初期位置
   contentRect基準で計算:
   - background: 65x65px, border: 1px → contentRect: 63x63px
   - contentRect中心: 31.5px
   - ノブ半径: 7px
   - 有効半径: min(31.5, 31.5) - 12 = 19.5px
   - 北方向（上）初期位置: left=31.5-7=24.5px, top=31.5-19.5-7=5px
*/
.light-direction-knob {
    position: absolute;
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    background-color: rgba(251,228,25,1);
    border-width: 1px;
    border-style: solid;
    border-color: rgba(255,255,255,1);

    left: 50%;
    top: 25%;
    translate: -50% -50%;
}

.light-direction-knob:hover {
    scale: 1.1;
}

/* Elevation コントロール - コンパクト */
.elevation-control {
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
}

.elev-title-bar{
  flex-direction: row;
  justify-content: center;
}

.elevation-value {
    font-size: 12px;
    margin-top: 0px;
    margin-bottom: 0px;
    padding-top: 0px;
    padding-bottom: 0px;
    line-height: 12px;
    color: rgba(250,250,250,1);
}

/* .elevation-label {
    font-size: 7px;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 1px;
} */

.elevation-slider {
    height: 124px;
    width: 8px;
}

.elevation-slider > .unity-base-slider__dragger {
    width: 24px;
    height: 16px;
    border-radius: 8px;
    background-color: white;
    border-width: 2px;
    border-color: rgba(76, 175, 255, 1);
    margin-left: -3px;
}

.elevation-slider > .unity-base-slider__tracker {
    width: 4px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.2);
}

/* ノブ周り：dragger / border / image 全部丸める */
.elevation-slider .unity-base-slider__dragger,
.elevation-slider .unity-base-slider__dragger-border,
.elevation-slider .unity-base-slider__checkmark-image {
    border-radius: 8px;
    background-image: none;
}

/* ラベルは消す */
/* .shadow-toggle Label,
.ar-sync-toggle Label {
    display: none;
} */

/* input は子孫指定で確実に当てる */
.shadow-toggle .unity-toggle__input,
.ar-sync-toggle .unity-toggle__input {
    width: 32px;
    height: 16px;
    min-width: 32px;
    min-height: 16px;
    max-width: 32px;
    max-height: 16px;
    border-radius: 8px;
    padding: 0;
    margin: 0;
    flex-grow: 0;
    flex-shrink: 0;
    overflow: hidden;
}

/* checkmark = トラック（背景の帯） */
.shadow-toggle .unity-toggle__checkmark,
.ar-sync-toggle .unity-toggle__checkmark {
    width: 32px;
    height: 16px;
    min-width: 32px;
    min-height: 16px;
    max-width: 32px;
    max-height: 16px;
    padding: 0;
    margin: 0;
    border-radius: 8px;
    /* デフォ画像は消す（帯だけにする） */
    background-image: none;
    border-width: 0;
    background-color: rgba(255, 255, 255, 0.2);
    position: relative;
    overflow: hidden;
}

/* checkmark-image = ノブとして再利用 */
.shadow-toggle .unity-toggle__checkmark-image,
.ar-sync-toggle .unity-toggle__checkmark-image {
    display: flex;
    position: absolute;
    left: 1px;
    top: 1px;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: white;
}

/* ON のとき帯の色 */
.shadow-toggle.unity-toggle--checked .unity-toggle__checkmark,
.ar-sync-toggle.unity-toggle--checked .unity-toggle__checkmark,
.shadow-toggle:checked .unity-toggle__checkmark,
.ar-sync-toggle:checked .unity-toggle__checkmark {
    background-color: rgba(1,168,212,1);
}

/* ON のときノブを右へ */
.shadow-toggle.unity-toggle--checked .unity-toggle__checkmark-image,
.ar-sync-toggle.unity-toggle--checked .unity-toggle__checkmark-image,
.shadow-toggle:checked .unity-toggle__checkmark-image,
.ar-sync-toggle:checked .unity-toggle__checkmark-image {
    left: 11px;
}


/* AR同期セクション - コンパクト（下部用・未使用） */
