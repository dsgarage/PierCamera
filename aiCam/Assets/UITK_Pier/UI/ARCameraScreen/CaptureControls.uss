/* ---------- Shadow Panel --------- */
/* note: Lighting panelのコンポーネントを活用しているので、uss短め */
#shadowPanel{
  height: 286px;
}
#enableShadowDivider{
  margin-left: 16px;
  margin-right: 16px;
}
#shadowSetContainer{
  flex-direction: column;
  padding-left: 16px;
  padding-right: 16px;
  padding-top: 8px;
  padding-bottom: 8px;
}
.slider-track-common{
  height: 8px;
  width: 100%;
  border-radius: 4px;
  background-color: rgba(115,115,115,1);
}
.common-slider-thumb{
  position: absolute;
  width: 24px;
  height: 24px;
  border-radius: 9999px;

  /* “中心が抜けない”見た目 */
  background-color: rgba(255,255,255,1);

  /* 影っぽさ（輪郭） */
  border-width: 1px;
  border-style: solid;
  border-color: rgba(175,170,172,1);

  left: 50%;
  top: 50%;
  translate: -50% -50%;
}
#shadowSoftnessSelections{
  justify-content: space-between;
}

/* Softnessのボタン均等配置だけ定義 */
#softnessSoft,
#softnessMedium,
#softnessHard{
  flex-grow: 1;
  justify-content: center;
}

/* 余白（gapが効かないので） */
#softnessSoft{ margin-right: 12px; }
#softnessMedium{ margin-right: 12px; }

/* #shadowPanel.debug-show{
  display: flex;
}  */
