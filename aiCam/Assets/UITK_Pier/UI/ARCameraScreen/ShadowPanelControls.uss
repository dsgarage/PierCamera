@import url("../Styles/tokens.uss");

/* ================================
   シャドウパネルスタイル
================================ */

/* オーバーレイ（パネルコンテナ） */
.shadow-panel-overlay {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 80px;
    background-color: transparent;
    display: none;
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
}

.shadow-panel-overlay.visible {
    display: flex;
}

/* メインパネル */
.shadow-panel {
    width: 100%;
    background-color: rgba(20, 20, 20, 0.95);
    border-radius: 10px;
    padding: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    flex-direction: column;
}

/* ヘッダー */
.shadow-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.15);
    height: 20px;
}

.shadow-panel-title {
    font-size: 12px;
    color: white;
    -unity-font-style: bold;
}

.shadow-panel-close {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: rgba(255, 255, 255, 0.15);
    border-width: 0;
    color: white;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.shadow-panel-close:hover {
    background-color: rgba(255, 255, 255, 0.3);
}

.shadow-panel-close:active {
    background-color: rgba(76, 175, 255, 0.5);
}

/* セクション */
.shadow-section {
    margin-bottom: 8px;
}

/* シャドウスライダー */
.shadow-slider {
    margin-top: 2px;
    margin-bottom: 2px;
    height: 16px;
}

.shadow-slider > .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: white;
    border-width: 2px;
    border-color: rgba(76, 175, 255, 1);
    margin-top: -5px;
}

.shadow-slider > .unity-base-slider__tracker {
    height: 4px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.2);
}
