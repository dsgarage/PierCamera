digraph UXMLHierarchy {
    // Graph settings
    rankdir=TB;
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=8];

    // Root
    root [label="root\n(.root)", fillcolor="#FFE4B5"];

    // Masks
    subgraph cluster_masks {
        label="Aspect Masks";
        style=filled;
        color="#F5F5F5";
        topMask [label="topMask", fillcolor="#E0E0E0"];
        bottomMask [label="bottomMask", fillcolor="#E0E0E0"];
        leftMask [label="leftMask", fillcolor="#E0E0E0"];
        rightMask [label="rightMask", fillcolor="#E0E0E0"];
    }

    // Alert
    alertBar [label="alertBar\n(.alert-bar)", fillcolor="#FFEB3B"];
    alertMessage [label="alertMessage\n[Label]", fillcolor="#FFF9C4"];
    alertClose [label="alertClose\n[Button]", fillcolor="#FFF9C4"];

    // Top Panel
    topPanel [label="topPanel\n(.top-panel)", fillcolor="#81C784"];
    topButton1 [label="topButton1\nLight", fillcolor="#C8E6C9"];
    topButton2 [label="topButton2\nShadow", fillcolor="#C8E6C9"];
    topButton3 [label="topButton3\nExpression", fillcolor="#C8E6C9"];
    topButton4 [label="topButton4\nPose", fillcolor="#C8E6C9"];
    topButton5 [label="topButton5\nPlane", fillcolor="#C8E6C9"];

    // Side Panel
    sidePanel [label="sidePanel\n(.side-panel)", fillcolor="#64B5F6"];
    sideButton1 [label="sideButton1\nSettings", fillcolor="#BBDEFB"];
    sideButton2 [label="sideButton2\nAspect", fillcolor="#BBDEFB"];
    sideButton3 [label="sideButton3\nFlash", fillcolor="#BBDEFB"];
    sideButtonBugReport [label="sideButtonBugReport", fillcolor="#BBDEFB"];

    // Bottom Panel
    bottomPanel [label="bottomPanel\n(.bottom-panel)", fillcolor="#BA68C8"];
    bottomScrollView [label="bottomScrollView\n[ScrollView]", fillcolor="#E1BEE7"];
    bottomButtonContainer [label="bottomButtonContainer", fillcolor="#F3E5F5"];
    bottomButton1 [label="bottomButton1", fillcolor="#F3E5F5"];
    bottomButtonAdd [label="bottomButtonAdd\n(+)", fillcolor="#F3E5F5"];

    // Capture Button
    captureButton [label="captureButton\n(.capture-button)", fillcolor="#EF5350"];
    outerRing [label="outerRing", fillcolor="#FFCDD2"];
    innerCircle [label="innerCircle", fillcolor="#FFCDD2"];
    progressRing [label="progressRing", fillcolor="#FFCDD2"];
    progressArc [label="progressArc", fillcolor="#FFEBEE"];

    // Overlays
    galleryThumbnail [label="galleryThumbnail", fillcolor="#90A4AE"];
    flashOverlay [label="flashOverlay", fillcolor="#ECEFF1"];
    viewerOverlay [label="viewerOverlay", fillcolor="#CFD8DC"];
    viewerImage [label="viewerImage\n[Image]", fillcolor="#ECEFF1"];
    iconPreviewPanel [label="iconPreviewPanel", fillcolor="#B0BEC5"];

    // Lighting Panel
    lightingPanelOverlay [label="lightingPanelOverlay\n(.lighting-panel-overlay)", fillcolor="#FFB74D"];
    lightingPanel [label="lightingPanel", fillcolor="#FFE0B2"];
    arSyncToggle [label="arSyncToggle\n[Toggle]", fillcolor="#FFF3E0"];
    presets [label="presetAuto..Sunset\n[Button x6]", fillcolor="#FFF3E0"];
    sliders [label="colorTempSlider\nbrightnessSlider\n[Slider]", fillcolor="#FFF3E0"];

    // Shadow Panel
    shadowPanelOverlay [label="shadowPanelOverlay\n(.shadow-panel-overlay)", fillcolor="#7986CB"];
    shadowPanel [label="shadowPanel", fillcolor="#C5CAE9"];
    shadowToggle [label="shadowToggle\n[Toggle]", fillcolor="#E8EAF6"];
    softness [label="softHard/Medium/Soft\n[Button x3]", fillcolor="#E8EAF6"];

    // Edges - Root children
    root -> {topMask bottomMask leftMask rightMask};
    root -> alertBar;
    root -> topPanel;
    root -> sidePanel;
    root -> galleryThumbnail;
    root -> bottomPanel;
    root -> captureButton;
    root -> flashOverlay;
    root -> viewerOverlay;
    root -> iconPreviewPanel;
    root -> lightingPanelOverlay;
    root -> shadowPanelOverlay;

    // Nested structures
    alertBar -> {alertMessage alertClose};
    topPanel -> {topButton1 topButton2 topButton3 topButton4 topButton5};
    sidePanel -> {sideButton1 sideButton2 sideButton3 sideButtonBugReport};
    bottomPanel -> bottomScrollView -> bottomButtonContainer;
    bottomButtonContainer -> {bottomButton1 bottomButtonAdd};
    captureButton -> {outerRing innerCircle progressRing};
    progressRing -> progressArc;
    viewerOverlay -> viewerImage;
    lightingPanelOverlay -> lightingPanel;
    lightingPanel -> {arSyncToggle presets sliders};
    shadowPanelOverlay -> shadowPanel;
    shadowPanel -> {shadowToggle softness};
}
